# Copy to .env and set real values for local/dev.

# IIIF endpoints
IIIF_MANIFEST_BASE=https://www-iiif-pres.canadiana.ca/manifest
IIIF_CONTENT_SEARCH_BASE=https://www-iiif-search.canadiana.ca/search

# Download API
DOWNLOAD_API_ENDPOINT=https://beta-download.canadiana.ca/download
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_TOKEN_TTL=1800

# Rails
RAILS_ENV=development
SECRET_KEY_BASE= # use `bin/rails secret` for production-like usage
