<%= content_tag @component,
  id: @id,
  data: {
    'document-id': @document.id.to_s.parameterize,
    'document-counter': @counter
  },
  itemscope: true,
  itemtype: @document.itemtype,
  class: classes.flatten.join(' ') do %>

  <%= header %>

  <% if body.present? %>
    <%= body %>
  <% else %>
    <div class="document-main-section">

      <% if @component.to_s == 'div' %>
        <% breadcrumb_paths = helpers.collection_breadcrumb_paths(@document) %>
        <% root_breadcrumb_label = I18n.locale.to_s.start_with?('fr') ? 'Collection Canadiana' : 'Canadiana Collection' %>
        <% if breadcrumb_paths.present? %>
          <nav class="collection-breadcrumbs mb-3" aria-label="<%= t('breadcrumbs.collections', default: 'Collections') %>">
            <% breadcrumb_paths.each do |path| %>
              <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item collection-breadcrumbs__root"><a href="/catalog"><%= root_breadcrumb_label %></a></li>
                <% path.each_with_index do |segment, idx| %>
                  <% active = (idx == path.length - 1) %>
                  <li class="breadcrumb-item <%= 'active' if active %>">
                    <%= link_to segment[:label],
                                helpers.collection_breadcrumb_url(segment[:value], segment[:field]),
                                aria: (active ? { current: 'page' } : {}) %>
                  </li>
                <% end %>
                <% if @document._source['is_issue']&.first == "Yes" && @document._source['serial_title'] %>
                  <li class="breadcrumb-item">
                    <a href="/catalog/<%= @document._source['serial_key'][0] %>"><%= @document._source['serial_title'][0] %></a>
                  </li> 
                <% end %>
              </ol>
            <% end %>
          </nav>
        <% end %>
      <% end %>

      <% if @component == :div %>
        <section class="document-overview" role="region" aria-label="<%= t('blacklight.main.aria.record_overview', default: 'Record overview') %>">
          <%= title %>
          <%= embed %>
          <%= content %>
        </section>
      <% else %>
        <div class="document-overview">
          <%= title %>
          <%= embed %>
          <%= content %>
        </div>
      <% end %>

      <% if @component == :div %>
        <div id="document-togglable-content" class="container-fluid">
          <div class="row flex-nowrap">
            <!-- Sidebar -->
            <aside id="toggle-menu" class="col" aria-labelledby="details-heading">
              <div class="document-sidebar-header">
                <h3 id="details-heading" class="h3 mb-0"><%= t('labels.L_SERIAL_RECORD') %></h3>
              </div>
              <div>  
               
                <ul class="list-unstyled mb-0" style="margin-top: 1rem;">
                  <li class="mb-1">
                    <a href="/catalog/<%= params[:id] %>/librarian_view" data-blacklight-modal="trigger" data-turbo="false">
                      <i class="bi bi-journal-text me-1" aria-hidden="true"></i>
                      <%= t('blacklight.tools.librarian_view') %>
                    </a>
                  </li>
                  <li>
                    <a href="/catalog/<%= params[:id] %>/citation" data-blacklight-modal="trigger" data-turbo="false">
                      <i class="bi bi-quote me-1" aria-hidden="true"></i>
                      <%= t('blacklight.tools.cite') %>
                    </a>
                  </li>
                </ul>

                <% if @document._source["is_serial"]&.first == "No" %>
                  <div>
                    <div class="mt-3 sidebar-downloads" id="download-toolbar" role="region" aria-label="<%= t('blacklight.tools.download_label', default: 'Downloads') %>"
                         data-docid="<%= @document._source['id'] %>"
                         data-arkpath="<%= @document._source['ark'].to_s.gsub('https://n2t.net/ark:/','') %>">
                      <p class="download-toolbar-title"><%= t('blacklight.tools.download_label', default: 'Downloads') %>:</p>
                      <div class="download-actions">
                        <a id="btn-download-img" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true" data-force-download="true">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">IMG</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_image_aria') %></span>
                        </a>
                        <a id="btn-download-page" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">PAGE</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_page_pdf_aria') %></span>
                        </a>
                        <a id="btn-download-full" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">FULL</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_full_pdf_aria') %></span>
                        </a>
                      </div>
                      <span id="download-status" class="text-muted small d-inline-flex align-items-center gap-1" aria-live="polite" aria-atomic="true">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="download-status-text"><%= t('blacklight.tools.download_checking') %></span>
                      </span>
                    </div>
                    <script>
                      (function(){
                        const bar = document.getElementById('download-toolbar');
                        if(!bar) return;

                        const docid = bar.dataset.docid;
                        const ark = bar.dataset.arkpath;

                        const full = document.getElementById('btn-download-full');
                        const page = document.getElementById('btn-download-page');
                        const pageImg = document.getElementById('btn-download-img');
                        const status = document.getElementById('download-status');
                        const statusText = status?.querySelector('.download-status-text');
                        const statusSpinner = status?.querySelector('.spinner-border');
                        const checkingText = <%= raw t('blacklight.tools.download_checking', default: 'Checking download availability...').to_json %>;
                        const unavailableText = <%= raw t('blacklight.tools.download_unavailable', default: 'Not available for this page.').to_json %>;
                        const loadingText = <%= raw t('blacklight.tools.download_loading', default: 'Preparing download...').to_json %>;
                        const availabilityCache = new Map();
                        let availabilityRun = 0;

                        function disableLink(el) {
                          if (!el) return;
                          el.classList.add('disabled');
                          el.setAttribute('aria-disabled', 'true');
                          el.removeAttribute('href');
                          el.removeAttribute('download');
                        }

                        function enableLink(el, href) {
                          if (!el || !href) return;
                          el.href = href;
                          if (el.dataset.loading === 'true') return;
                          el.classList.remove('disabled');
                          el.removeAttribute('aria-disabled');
                          if (el.dataset.forceDownload === 'true') {
                            el.setAttribute('download', '');
                          }
                        }

                        function currentPageNum() {
                          const p = parseInt(new URLSearchParams(window.location.search).get('pageNum') || '1', 10);
                          return Number.isFinite(p) && p > 0 ? p : 1;
                        }

                        function safeDocId() {
                          return String(docid || 'document').replace(/[^\w.-]+/g, '_');
                        }

                        function sanitizeFileName(value) {
                          return String(value || '').replace(/[\\/:*?"<>|]+/g, '_');
                        }

                        function inferFileNameFromUrl(url, fallbackExt) {
                          const ext = (fallbackExt || 'jpg').replace(/^\./, '');
                          try {
                            const parsed = new URL(url, window.location.href);
                            const filename = parsed.searchParams.get('filename');
                            const slug = parsed.searchParams.get('slug');
                            if (filename) return sanitizeFileName(filename);
                            if (slug) return sanitizeFileName(`${slug}.${ext}`);
                          } catch (_error) {}
                          return sanitizeFileName(`${safeDocId()}.${currentPageNum()}.${ext}`);
                        }

                        async function forceFileDownload(url, fallbackExt) {
                          const response = await fetch(url, { credentials: 'omit', cache: 'no-store' });
                          if (!response.ok) throw new Error(`Download failed: ${response.status}`);
                          const blob = await response.blob();
                          const contentType = String(response.headers.get('content-type') || '').toLowerCase();
                          const inferredExt =
                            contentType.includes('pdf') ? 'pdf' :
                            contentType.includes('png') ? 'png' :
                            contentType.includes('webp') ? 'webp' :
                            contentType.includes('tif') || contentType.includes('tiff') ? 'tif' :
                            contentType.includes('jp2') ? 'jp2' :
                            (fallbackExt || 'jpg');
                          const blobUrl = URL.createObjectURL(blob);
                          const link = document.createElement('a');
                          link.href = blobUrl;
                          link.download = inferFileNameFromUrl(url, inferredExt);
                          document.body.appendChild(link);
                          link.click();
                          link.remove();
                          setTimeout(() => URL.revokeObjectURL(blobUrl), 1500);
                        }

                        function setStatus(message, loading) {
                          if (statusText) statusText.textContent = message || '';
                          if (statusSpinner) statusSpinner.hidden = !loading;
                        }

                        function setBusy(el, loading) {
                          if (!el) return;
                          if (loading) {
                            el.dataset.loading = 'true';
                            el.setAttribute('aria-busy', 'true');
                            el.classList.add('disabled');
                          } else {
                            delete el.dataset.loading;
                            el.removeAttribute('aria-busy');
                            if (el.getAttribute('href')) {
                              el.classList.remove('disabled');
                              el.removeAttribute('aria-disabled');
                            }
                          }
                        }

                        function setLinkState(el, href, exists) {
                          if (!el || !href) return disableLink(el);
                          if (!exists) return disableLink(el);
                          enableLink(el, href);
                        }

                        function isEnabled(el) {
                          return !!(el && el.getAttribute('href') && !el.classList.contains('disabled'));
                        }

                        function showFinalStatus() {
                          const anyEnabled = [full, page, pageImg].some(isEnabled);
                          setStatus(anyEnabled ? '' : unavailableText, false);
                        }

                        function currentPageIndex() {
                          return currentPageNum() - 1;
                        }

                        function currentDownloads(data) {
                          const idx = currentPageIndex();
                          const listPdf = data?.canvasDownloadPdfUris || [];
                          const listImg = data?.canvasDownloadImgUris || [];
                          return {
                            idx,
                            pagePdfUri: listPdf[idx],
                            pageImgUri: listImg[idx]
                          };
                        }

                        function encodedArkPath() {
                          return String(ark || '').split('/').map(encodeURIComponent).join('/');
                        }

                        function downloadDataUrl() {
                          const params = new URLSearchParams({
                            pageNum: String(currentPageNum()),
                            _: String(Date.now())
                          });
                          return `/dl/${encodeURIComponent(docid)}/${encodedArkPath()}?${params.toString()}`;
                        }

                        async function fetchDownloadData() {
                          const response = await fetch(downloadDataUrl(), {
                            credentials: 'same-origin',
                            cache: 'no-store'
                          });
                          if (!response.ok) throw new Error(`Download metadata failed: ${response.status}`);
                          return response.json();
                        }

                        function checkDownloadUrl(url) {
                          if (!url) return Promise.resolve(false);
                          if (availabilityCache.has(url)) return availabilityCache.get(url);

                          const check = fetch(url, {
                            method: 'HEAD',
                            credentials: 'omit',
                            cache: 'no-store'
                          })
                            .then(response => response.ok)
                            .catch(() => false);

                          availabilityCache.set(url, check);
                          return check;
                        }

                        async function updateForCurrentPage(data){
                          if (!data) return;
                          const run = ++availabilityRun;
                          const current = currentDownloads(data);
                          const checks = [];

                          setStatus(checkingText, true);
                          disableLink(full);
                          disableLink(page);
                          setLinkState(pageImg, current.pageImgUri, !!current.pageImgUri);

                          if (data.docPdfUri) {
                            checks.push(checkDownloadUrl(data.docPdfUri).then(exists => {
                              if (run === availabilityRun) setLinkState(full, data.docPdfUri, exists);
                            }));
                          }

                          if (current.pagePdfUri) {
                            checks.push(checkDownloadUrl(current.pagePdfUri).then(exists => {
                              if (run === availabilityRun) setLinkState(page, current.pagePdfUri, exists);
                            }));
                          }

                          if (checks.length > 0) {
                            await Promise.all(checks);
                          }

                          if (run === availabilityRun) {
                            showFinalStatus();
                          }
                        }

                        // Fetch once, then update on URL changes
                        let dlData = null;
                        fetchDownloadData()
                          .then(data => {
                            dlData = data;
                            updateForCurrentPage(dlData);
                          })
                          .catch(() => {
                            disableLink(full);
                            disableLink(page);
                            disableLink(pageImg);
                            setStatus(unavailableText, false);
                          });

                        async function downloadPdf(kind, event) {
                          event.preventDefault();

                          const link = kind === 'full' ? full : page;
                          if (!link || link.dataset.loading === 'true' || link.classList.contains('disabled')) return;

                          setBusy(link, true);
                          setStatus(loadingText, true);

                          try {
                            const freshData = await fetchDownloadData();
                            const current = currentDownloads(freshData);
                            const href = kind === 'full' ? freshData.docPdfUri : current.pagePdfUri;
                            if (!href) throw new Error('Missing download URL');

                            await forceFileDownload(href, 'pdf');
                            dlData = freshData;
                            availabilityCache.set(href, Promise.resolve(true));
                            enableLink(link, href);
                            setStatus('', false);
                          } catch (_error) {
                            disableLink(link);
                            setStatus(unavailableText, false);
                          } finally {
                            setBusy(link, false);
                          }
                        }

                        if (full) {
                          full.addEventListener('click', (event) => downloadPdf('full', event));
                        }

                        if (page) {
                          page.addEventListener('click', (event) => downloadPdf('page', event));
                        }

                        // Force image to download instead of opening in a new tab.
                        if (pageImg) {
                          pageImg.addEventListener('click', async (event) => {
                            if (pageImg.classList.contains('disabled')) {
                              event.preventDefault();
                              return;
                            }
                            const href = pageImg.getAttribute('href');
                            if (!href) {
                              event.preventDefault();
                              return;
                            }
                            event.preventDefault();
                            try {
                              await forceFileDownload(href, 'jpg');
                            } catch (_error) {
                              // Fallback for strict CORS setups: attempt native download attribute.
                              const fallbackLink = document.createElement('a');
                              fallbackLink.href = href;
                              fallbackLink.download = inferFileNameFromUrl(href, 'jpg');
                              document.body.appendChild(fallbackLink);
                              fallbackLink.click();
                              fallbackLink.remove();
                            }
                          });
                        }

                        // Listen for navigation events that may change the query string
                        function onLocationChange(){ updateForCurrentPage(dlData); }
                        window.addEventListener('popstate', onLocationChange);
                        window.addEventListener('hashchange', onLocationChange);

                        // Poll for pageNum changes (covers pushState/replaceState navigation in viewer)
                        let lastSearch = window.location.search;
                        setInterval(() => {
                          if (window.location.search !== lastSearch) {
                            lastSearch = window.location.search;
                            onLocationChange();
                          }
                        }, 750);
                      })();
                    </script>
                  </div>
                <% end %>
                 
                <%= metadata %>
                <% metadata_sections.each do |section| %>
                  <%= section %>
                <% end %>

              </div>
            </aside>
            <!-- Main Content -->
            <div id="doc-main" class="col">

              <% if @document._source["is_serial"]&.first == "No" %>
                <% if @document._source["ark"] %>
                  <div id="my-mirador" data-docid="<%= @document._source['ark'] %>"></div>
                  
                <% else %>
                  <img src="/assets/404.webp" class="not-found-icon" alt="Item image unavailable" />
                  <p>Sorry, there was a problem loading the images for this item.</p>
                <% end %>

                <%= render(::IiifComponent.new(document: @document, term: params[:q])) %>
              <% else %>
                <%= render CollectionItemsComponent.new(
                  documentId: params[:id],
                  page: params[:page] || 1,
                  per_page: 12
                ) %>
              <% end %>
            </div>
          </div>
        </div>



      <% else %>
        <%= metadata %>
        <% metadata_sections.each do |section| %>
          <%= section %>
        <% end %>
        <%= thumbnail %>
        <%= render(::PageSearchComponent.new(docId: @document._source["id"] , arkUrl: @document._source["ark"], term: params[:q])) %>
      <% end %>

      <br/>
      <% partials.each do |partial| %>
        <%= partial %>
      <% end %>
    </div>
  <% end %>

  <%= footer %>
<% end %>
