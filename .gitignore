# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles (keep directory .keep files).
/log/*
!/log/.keep
*.log
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/tmp/cache/*

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Ignore compiled public assets
/public/assets

# JavaScript / Node package managers
node_modules/
/node_modules/
.vite/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity
.pnp.*
yarn-error.log*
yarn-debug.log*

# Solr runtime index data, logs, and locks
/data/data/**/data/
/data/data/**/data
/data/data/**/write.lock
/data/data/**/core.properties
/data/logs
/data/log4j2.xml

# Secrets, keys, credentials, and environment configurations
config/blacklight.yml
config/master.key
config/credentials/*.key
*.key
*.pem
.env
.env.*
.env.local
.env.*.local
.env.example
.env.dev

# Local scripts / docs scratch
script
docs/*

# OS and Editor metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/