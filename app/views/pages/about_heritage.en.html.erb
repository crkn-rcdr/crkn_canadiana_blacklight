<% content_for :page_title, "About the Héritage Collection - #{application_name}" %>
<% heritage_search_link = search_catalog_path(lang: I18n.locale) %>

<div class="about-heritage-page">
  <section
    class="site-section about-heritage-hero"
    style="--about-heritage-hero-image: url('<%= asset_path('backgrounds/heritage/oocihm.lac_reel_c13421.54.jpg') %>');"
  >
    <div class="canadiana-shell">
      <div class="about-heritage-hero__layout">
        <div class="about-heritage-hero__copy">
          <h1 class="about-heritage-hero__title">About the Héritage Collection</h1>
          <p class="about-heritage-hero__text">
            The Héritage Collection contains approximately 37.5 million pages from over 1,000 archival collections,
            spanning c. 1500 to 1985 and digitized from Library and Archives Canada&rsquo;s microfilm holdings.
          </p>
          <div class="about-heritage-hero__actions">
            <a class="about-heritage-hero__cta" href="<%= heritage_search_link %>">
              <span>Search the Héritage Collection</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <a
          class="about-heritage-hero__credit"
          href="https://heritage.canadiana.ca/view/oocihm.lac_reel_c13421/54"
          target="_blank"
          rel="noopener"
        >
          Chinese immigration records: Sample Chinese immigration certificates : C-13421
          <span aria-hidden="true">↗</span>
        </a>

        <aside class="about-heritage-hero__partner-card" aria-label="In partnership with Library and Archives Canada">
          <img src="<%= asset_path('lac.jpg') %>" alt="Library and Archives Canada logo" loading="lazy">
          <p>
            In partnership with
            <a href="https://www.canada.ca/en/library-archives.html" target="_blank" rel="noopener">Library and Archives Canada.</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="site-section about-heritage-essentials">
    <div class="canadiana-shell">
      <div class="about-heritage-section-head">
        <h2>An Essential Resource</h2>
      </div>

      <div class="about-heritage-essentials__grid">
        <article class="about-heritage-essential-card">
          <img
            src="<%= asset_path('about/heritage/oocihm.lac_reel_h1700.190.jpg') %>"
            alt="Archival manuscript from the Héritage Collection"
            loading="lazy"
          >
          <p>
            Unique archival records digitized from
            <a href="https://www.canada.ca/en/library-archives.html" target="_blank" rel="noopener">Library and Archives Canada</a>
            holdings, with new material added regularly.
          </p>
        </article>

        <article class="about-heritage-essential-card">
          <img
            src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_h1228.150.jpg') %>"
            alt="Historic homestead image from the Héritage Collection"
            loading="lazy"
          >
          <p>
            About 37.5 million pages of primary sources: government records, Indigenous history, genealogy, military
            records, and handwritten papers.
          </p>
        </article>

        <article class="about-heritage-essential-card">
          <img
            src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_t12502.1426.jpg') %>"
            alt="Handwritten archival card from the Héritage Collection"
            loading="lazy"
          >
          <p>Coverage from c. 1500 to 1985.</p>
        </article>

        <article class="about-heritage-essential-card">
          <img
            src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_c1845.9.jpg') %>"
            alt="Historic research notes from the Héritage Collection"
            loading="lazy"
          >
          <p>Supports historians, researchers, students, and genealogists.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="site-section about-heritage-topics">
    <div class="canadiana-shell">
      <div class="about-heritage-section-head">
        <h2>What you can find in the Héritage Collection</h2>
      </div>

      <div class="about-heritage-topic-list">
        <article class="about-heritage-topic">
          <div class="about-heritage-topic__media">
            <img
              src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_c2925.95.jpg') %>"
              alt="Genealogy record from the Héritage Collection"
              loading="lazy"
            >
          </div>
          <div class="about-heritage-topic__copy">
            <h3>Genealogy Materials</h3>
            <p>Immigration records, church records, land records, family histories and papers, and voters&rsquo; lists.</p>
            <a class="about-heritage-browse" href="<%= heritage_search_link %>">
              <span>Browse</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="about-heritage-topic about-heritage-topic--reverse">
          <div class="about-heritage-topic__media">
            <img
              src="<%= asset_path('about/heritage/oocihm.lac_reel_h1700.190.jpg') %>"
              alt="Indigenous history document from the Héritage Collection"
              loading="lazy"
            >
          </div>
          <div class="about-heritage-topic__copy">
            <h3>Indigenous Peoples</h3>
            <p>Extensive documents relating to First Nations, Métis, and Inuit communities in Canada.</p>
            <a class="about-heritage-browse" href="<%= heritage_search_link %>">
              <span>Browse</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="about-heritage-topic">
          <div class="about-heritage-topic__media">
            <img
              src="<%= asset_path('about/heritage/oocihm.lac_reel_c15645.23.jpg') %>"
              alt="Government record from the Héritage Collection"
              loading="lazy"
            >
          </div>
          <div class="about-heritage-topic__copy">
            <h3>Government Departments</h3>
            <p>Early records from Indian Affairs, Immigration, Health, Agriculture, Railways and Canals, Fisheries, and Natural Resources.</p>
            <a class="about-heritage-browse" href="<%= heritage_search_link %>">
              <span>Browse</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="about-heritage-topic about-heritage-topic--reverse">
          <div class="about-heritage-topic__media">
            <img
              src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_c1845.9.jpg') %>"
              alt="Military record from the Héritage Collection"
              loading="lazy"
            >
          </div>
          <div class="about-heritage-topic__copy">
            <h3>Military History</h3>
            <p>Materials covering the War of 1812, First World War, World War II, and military administration in peacetime.</p>
            <a class="about-heritage-browse" href="<%= heritage_search_link %>">
              <span>Browse</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="about-heritage-topic">
          <div class="about-heritage-topic__media">
            <img
              src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_t12502.1426.jpg') %>"
              alt="Prominent Canadians record from the Héritage Collection"
              loading="lazy"
            >
          </div>
          <div class="about-heritage-topic__copy">
            <h3>Prominent Canadians</h3>
            <p>Papers from prime ministers, governors general, premiers, cabinet ministers, explorers, scientists, writers, and artists.</p>
            <a class="about-heritage-browse" href="<%= heritage_search_link %>">
              <span>Browse</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="site-section about-heritage-work">
    <div class="canadiana-shell">
      <div class="about-heritage-work__grid">
        <div class="about-heritage-work__media">
          <img
            src="<%= asset_path('backgrounds/heritage/oocihm.lac_reel_c13525.63.jpg') %>"
            alt="Handwritten archival letter from the Héritage Collection"
            loading="lazy"
          >
        </div>

        <article class="about-heritage-work__copy" aria-labelledby="heritage-work-title">
          <h2 id="heritage-work-title">How to Work with the Collection</h2>
          <ol>
            <li>
              To get started, enter your search terms into the Héritage search box. The basic search helps guide you to
              collections that match your keywords. It searches descriptive information, microfilm reel numbers,
              metadata, and, where available, document text. To refine your query, use techniques from
              <a href="<%= navigating_collections_path(lang: I18n.locale) %>">Navigating the Collections</a>, including
              exact phrases in quotes and operators like <code>?</code>, <code>*</code>, <code>-</code>, and
              <code>|</code>. You can also explore Héritage by subject matter by browsing the five thematic areas above.
            </li>
            <li>
              Next, choose the archival collection that best matches your research interest. Each individual collection
              page includes information about the collection as well as archival references. This information, drawn
              from
              <a href="https://recherche-collection-search.bac-lac.gc.ca/eng/home/index" target="_blank" rel="noopener">Library and Archives Canada&rsquo;s Collection Search catalogue</a>,
              was generously shared to help ease of access.
            </li>
            <li>
              When you find relevant records, download them with the <code>IMG</code>, <code>PAGE</code>, and
              <code>FULL</code> options (if available), and copy the persistent URL from the record.
            </li>
            <li>
              For citations, please follow the <a href="<%= citation_guide_path(lang: I18n.locale) %>">Citation Guide</a>:
              cite Canadiana as the source and include the persistent URL. For publicly available works, please send a
              copy or link to CRKN.
            </li>
          </ol>
        </article>
      </div>
    </div>
  </section>

  <section class="site-section about-heritage-faq">
    <div class="canadiana-shell">
      <h2>FAQ</h2>

      <div class="about-heritage-faq__list">
        <details open>
          <summary>Is full-text search available now?</summary>
          <p>Very little archival text is currently visible to our search tools.</p>
        </details>

        <details>
          <summary>What is planned for full-text discovery?</summary>
          <p>
            Transcribing these records to produce searchable text will take time and resources and remains a major
            project objective. Future versions of Héritage will support full-text searching as records are transcribed.
          </p>
        </details>

        <details>
          <summary>What comes next for research support?</summary>
          <p>
            Over the coming years, additional research tools and infrastructure for enhanced metadata creation and
            linking will be developed by Canadiana and its Héritage partners.
          </p>
        </details>
      </div>
    </div>
  </section>
</div>
